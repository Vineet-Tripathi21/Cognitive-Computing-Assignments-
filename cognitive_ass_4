    "import pandas as pd\n",
    "fixed_entries = [\n",
    "    {\n",
    "        \"question\": \"what is the annual fee\",\n",
    "        \"answer\": \"The annual fee is Rs 500.\",\n",
    "        \"keywords\": \"fee cost price charge\",\n",
    "        \"category\": \"billing\"\n",
    "    },\n",
    "    {\n",
    "        \"question\": \"how to reset password\",\n",
    "        \"answer\": \"Go to Settings > Reset Password.\",\n",
    "        \"keywords\": \"password reset login\",\n",
    "        \"category\": \"account\"\n",
    "    },\n",
    "    {\n",
    "        \"question\": \"what are your working hours\",\n",
    "        \"answer\": \"We are open 9 AM to 5 PM.\",\n",
    "        \"keywords\": \"hours timing open time\",\n",
    "        \"category\": \"general\"\n",
    "    },\n",
    "    {\n",
    "        \"question\": \"how can i pay the fee\",\n",
    "        \"answer\": \"You can pay via UPI, card, or net banking.\",\n",
    "        \"keywords\": \"pay payment upi fee\",\n",
    "        \"category\": \"billing\"\n",
    "    }\n",
    "]\n",
    "\n",
    "roll_number = 1024170252\n",
    "\n",
    "last_two_digits = [\n",
    "    roll_number % 100 // 10,\n",
    "    roll_number % 10\n",
    "]\n",
    "\n",
    "categories = [\"billing\", \"account\", \"general\"]\n",
    "\n",
    "personalized_entries = []\n",
    "\n",
    "personalized_entries.append({\n",
    "    \"question\": \"how can i update my profile information\",\n",
    "    \"answer\": \"You can update your profile information from the account settings.\",\n",
    "    \"keywords\": \"profile update information\",\n",
    "    \"category\": categories[last_two_digits[0] % 3]\n",
    "})\n",
    "\n",
    "personalized_entries.append({\n",
    "    \"question\": \"where can i view general account information\",\n",
    "    \"answer\": \"You can view your general account information from the dashboard.\",\n",
    "    \"keywords\": \"account information dashboard\",\n",
    "    \"category\": categories[last_two_digits[1] % 3]\n",
    "})\n",
    "\n",
    "\n",
    "all_entries = fixed_entries + personalized_entries\n",
    "\n",
    "df = pd.DataFrame(all_entries)\n",
    "\n",
    "print(\"Final 6-row DataFrame\")\n",
    "print(df)"
   ]
