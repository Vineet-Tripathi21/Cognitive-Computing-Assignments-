    "def score_query_with_ties(query, df):\n",
    "\n",
    "    query_words = query.lower().split()\n",
    "\n",
    "    results = []\n",
    "\n",
    "    for index, row in df.iterrows():\n",
    "\n",
    "        keywords = row[\"keywords\"].lower().split()\n",
    "\n",
    "        score = 0\n",
    "\n",
    "        for word in query_words:\n",
    "            if word in keywords:\n",
    "                score += 1\n",
    "\n",
    "        if score > 0:\n",
    "            results.append({\n",
    "                \"index\": index,\n",
    "                \"question\": row[\"question\"],\n",
    "                \"answer\": row[\"answer\"],\n",
    "                \"category\": row[\"category\"],\n",
    "                \"score\": score\n",
    "            })\n",
    "\n",
    "    if not results:\n",
    "        print(\"No matching entries found.\")\n",
    "        return\n",
    "\n",
    "    max_score = max(result[\"score\"] for result in results)\n",
    "\n",
    "    best_matches = [\n",
    "        result\n",
    "        for result in results\n",
    "        if result[\"score\"] == max_score\n",
    "    ]\n",
    "\n",
    "    print(\"\\nHighest confidence score:\", max_score)\n",
    "\n",
    "    if len(best_matches) > 1:\n",
    "        print(\"Tie detected! All matching entries:\")\n",
    "\n",
    "    for result in best_matches:\n",
    "        print(result)\n",
    "\n",
    "print(\"\\nTie demonstration\")\n",
    "\n",
    "print(\"\\nQuery producing a tie:\")\n",
    "score_query_with_ties(\"fee\", df)\n",
    "\n",
    "print(\"\\nQuery not producing a tie:\")\n",
    "score_query_with_ties(\"password\", df)"
   ]
